{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GazeForge ten-frame sweep",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "required": [
      "frame",
      "theta",
      "input",
      "camera_matrix",
      "eye_rotation_L",
      "pupil_center_2D_L",
      "eye_rotation_R",
      "pupil_center_2D_R"
    ],
    "additionalProperties": false,
    "properties": {
      "frame": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "theta": {
        "type": "number"
      },
      "input": {
        "type": "object",
        "required": [
          "h",
          "v"
        ],
        "additionalProperties": false,
        "properties": {
          "h": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "v": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      },
      "camera_matrix": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "extra": {
        "type": "object"
      },
      "eye_rotation_L": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      },
      "pupil_center_2D_L": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      },
      "eye_rotation_R": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      },
      "pupil_center_2D_R": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    }
  }
}
